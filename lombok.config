# ============================================================================
# Lombok 공통 설정 (팀 전원 동일 동작 보장). backend/ 루트에 두면 하위 전체 적용.
# ============================================================================

# 이 파일이 설정 루트. 상위 디렉토리의 lombok.config 를 더 찾지 않는다.
config.stopBubbling = true

# 생성자 주입 시 Spring 이 인식하도록, 생성된 생성자에 @Autowired 등을 붙일 필요 없게 함.
# (생성자가 하나면 Spring 이 자동 주입하므로 별도 애노테이션 불필요)

# @Data 등이 만드는 equals/hashCode 에서 상위 클래스 필드도 고려하도록 경고 억제 안 함(안전).
lombok.equalsAndHashCode.callSuper = warn

# @NonNull 로 생성되는 null 체크 예외를 IllegalArgumentException 대신 명확히.
lombok.nonNull.exceptionType = IllegalArgumentException

# 빌더에서 컬렉션 기본값 등을 다룰 때 유용. toBuilder 는 명시적으로만 쓰게 유지.
lombok.builder.className = *Builder

# 생성된 코드에 @lombok.Generated 를 붙여 커버리지 측정에서 제외되게 함.
lombok.addLombokGeneratedAnnotation = true
