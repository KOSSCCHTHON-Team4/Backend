# DEPLOY-CFG-R1 production Compose input template. This file contains no usable
# deployment values. Copy it to a protected file outside the repository (mode
# 0600) and pass that file with docker compose --env-file; never source or eval
# it. Host environment values override --env-file values, so remove conflicts.
#
# Classifications: M = required Compose input; F = fixed or derived by
# compose.yaml; C = conditional input; O = optional implemented override.
# Quote literal values containing $, #, or spaces in the protected Compose env
# file. Do not use shell expansion for secrets.

# M — stable deployment identity and release image. API_IMAGE must be a unique,
# release-specific tag; never use latest.
COMPOSE_PROJECT_NAME=
API_IMAGE=

# M — DB topology and approved shutdown durations. DB_HOST_PORT must be 1–65535;
# DB_NETWORK_SUBNET and DB_IPV4_ADDRESS are fixed after activation and the port is host-loopback only.
DB_NAME=
DB_NETWORK_SUBNET=
DB_IPV4_ADDRESS=
DB_HOST_PORT=
API_SHUTDOWN_TIMEOUT=
API_STOP_GRACE_PERIOD=
DB_STOP_GRACE_PERIOD=

# M — database and application security. DB_NAME and DB_USERNAME must match
# [a-z_][a-z0-9_]{0,62}, excluding postgres, template0, template1, and pg_ names.
# Both DB secrets are non-empty single-line values; POSTGRES_PASSWORD is bootstrap-admin only and
# must differ from non-superuser DB_PASSWORD. JWT_SECRET and SIGNING_SECRET must
# be different random UTF-8 values of at least 32 bytes.
DB_USERNAME=
DB_PASSWORD=
POSTGRES_PASSWORD=
JWT_SECRET=
SIGNING_SECRET=
PASSWORD_BCRYPT_STRENGTH=
LOGIN_FAILED_ATTEMPT_WINDOW_SECONDS=

# M — approved service policy values. Blank is intentionally not a local/test
# default and leaves the production deployment invalid.
SERVICE_CONFIG_VERSION=
SERVICE_RADIUS_METERS=
SERVICE_DEMO_CENTER_LAT=
SERVICE_DEMO_CENTER_LNG=
SERVICE_LIMIT_MEMORY_CONTENT_MAX_CODE_POINTS=
SERVICE_LIMIT_PREFERENCE_DESCRIPTION_MAX_CODE_POINTS=
SERVICE_LIMIT_REPORT_DETAILS_MAX_CODE_POINTS=
SERVICE_LIMIT_IMAGE_MAX_BYTES=
SERVICE_LIMIT_IMAGE_MAX_WIDTH=
SERVICE_LIMIT_IMAGE_MAX_HEIGHT=
SERVICE_LIMIT_IMAGE_MAX_PIXELS=
SERVICE_LIMIT_IMAGE_UPLOAD_TTL_SECONDS=
SERVICE_LIMIT_ANALYSIS_TTL_SECONDS=
SERVICE_LIMIT_DAILY_DIRECT_MEMORY_LIMIT=
SERVICE_LIMIT_DEFAULT_PAGE_LIMIT=
SERVICE_LIMIT_MAX_PAGE_LIMIT=
SERVICE_LIMIT_MAX_MAP_PAGE_LIMIT=
SERVICE_AUTH_ACCESS_TOKEN_TTL_SECONDS=
SERVICE_AUTH_FAILED_LOGIN_LIMIT=
SERVICE_AUTH_LOGIN_LOCK_SECONDS=

# M — upload accounting and the integrated V9 lifecycle settings.
# Explicit empty-root activation is required before new image writes.
# Actual container startup and production readiness require separate verification.
APP_STORAGE_MULTIPART_REQUEST_OVERHEAD_BYTES=
REQUEST_COORDINATION_LEASE_DURATION=
IMAGE_CLEANUP_INTERVAL=
IMAGE_CLEANUP_BATCH_SIZE=

# M — real HTTP AI provenance and timeout inputs. No mock provider is accepted
# by this production manifest.
AI_TIMEOUT=
AI_ANALYSIS_MODEL=
AI_ANALYSIS_PROMPT_VERSION=
AI_MODERATION_MODEL=
AI_MODERATION_PROMPT_VERSION=

# C — supply AI_SERVICE_TOKEN only when the host AI service contract requires
# it. It is an AI credential and must never reuse DB_PASSWORD or POSTGRES_PASSWORD.
# C/O — CORS_ALLOWED_ORIGINS is needed only for a separate browser origin; blank
# keeps cross-origin requests disallowed.
AI_SERVICE_TOKEN=
CORS_ALLOWED_ORIGINS=

# O — existing infrastructure/application defaults. Blank API_PORT uses 8080.
# Blank MATCH_* values preserve the current application defaults. Moderation
# values default to PT5M/PT1M when omitted or blank.
API_PORT=
MATCH_RADIUS_METERS=
MATCH_FALLBACK_RADIUS_METERS=
MATCH_MIN_PLACES=
MATCH_NOTIFY_THRESHOLD=
MATCH_VERIFY_THRESHOLD=
MATCH_SIMILARITY_WEIGHT=
MATCH_DISTANCE_WEIGHT=
MATCH_PLACE_VIBE_SMOOTHING=
MATCH_MERGE_DISTANCE_METERS=
MATCH_CATEGORY_CONFIDENCE_THRESHOLD=
MATCH_REVIEWS_FOR_VERIFY=
MODERATION_RETRY_DELAY=
MODERATION_RETRY_INITIAL_DELAY=

# F — compose.yaml supplies these; do not override them in this file.
# POSTGRES_USER=postgres
# POSTGRES_DB=postgres
# POSTGRES_INITDB_ARGS=--auth-host=scram-sha-256
# SPRING_PROFILES_ACTIVE=prod
# DB_URL=jdbc:postgresql://127.0.0.1:${DB_HOST_PORT}/${DB_NAME}?currentSchema=public
# DB_SCHEMA=public
# APP_UPLOAD_DIR=/var/lib/emotionmap/uploads
# AI_PROVIDER=http
# AI_BASE_URL=http://127.0.0.1:8001
# SERVER_ADDRESS=127.0.0.1
# SERVER_PORT=${API_PORT:-8080}
# SERVER_SHUTDOWN=graceful
# SPRING_LIFECYCLE_TIMEOUT_PER_SHUTDOWN_PHASE=${API_SHUTDOWN_TIMEOUT}
# SPRING_JPA_HIBERNATE_DDL_AUTO=validate
# SPRING_FLYWAY_ENABLED=true
# SPRING_FLYWAY_VALIDATE_ON_MIGRATE=true
# SPRING_FLYWAY_BASELINE_ON_MIGRATE=false
# SPRING_FLYWAY_CLEAN_DISABLED=true
